{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appleweiping.github.io/Regressistor/schemas/measurement-bundle-1.schema.json",
  "title": "Regressistor measurement bundle v1",
  "type": "object",
  "required": ["schema_version", "run", "points"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "run": {
      "type": "object",
      "allOf": [{
        "if": {
          "required": ["contract"],
          "properties": {"contract": {"const": "regressistor.measurement-bundle/1"}}
        },
        "then": {
          "required": ["producer", "contract", "aggregate_activity_id"],
          "properties": {
            "producer": {"const": "SimCairn"},
            "contract": {"const": "regressistor.measurement-bundle/1"},
            "aggregate_activity_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "frozen_from_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      }]
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/point"}
    }
  },
  "$defs": {
    "portableName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        {"type": ["integer", "number", "boolean"]}
      ]
    },
    "measurement": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "number"},
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["case", "sample", "metrics"],
      "additionalProperties": false,
      "properties": {
        "case": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/portableName"},
          "additionalProperties": {"$ref": "#/$defs/scalar"}
        },
        "sample": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {"type": "integer"}
          ]
        },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/portableName"},
          "additionalProperties": {"$ref": "#/$defs/measurement"}
        }
      }
    }
  }
}
